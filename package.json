{
  "name": "nexus-bot-worker-commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Nexus bot Worker scaffolding: chat callback handler, Anthropic tool-use loop, HMAC verify, D1 history/facts, HITL approval cards. Workers globals only, no runtime deps. Consumed via file:../nexus-bot-worker-commons by each per-bot worker.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./handlers/handleChatMessage": "./src/handlers/handleChatMessage.js",
    "./handlers/handleCommandList": "./src/handlers/handleCommandList.js",
    "./lib/anthropic": "./src/lib/anthropic.js",
    "./lib/contentJudge": "./src/lib/contentJudge.js",
    "./lib/actionTrace": "./src/lib/actionTrace.js",
    "./lib/callbackSign": "./src/lib/callbackSign.js",
    "./lib/twilioSig": "./src/lib/twilioSig.js",
    "./lib/voicePersona": "./src/lib/voicePersona.js",
    "./lib/avatarPersona": "./src/lib/avatarPersona.js",
    "./lib/commandParser": "./src/lib/commandParser.js",
    "./lib/history": "./src/lib/history.js",
    "./lib/memory": "./src/lib/memory.js",
    "./lib/nexus": "./src/lib/nexus.js",
    "./lib/hitl": "./src/lib/hitl.js",
    "./lib/triggers": "./src/lib/triggers.js",
    "./lib/attachments": "./src/lib/attachments.js",
    "./lib/memoryService": "./src/lib/memoryService.js",
    "./lib/format": "./src/lib/format.js",
    "./lib/embedCard": "./src/lib/embedCard.js",
    "./lib/aiDisclosure": "./src/lib/aiDisclosure.js",
    "./lib/appLinks": "./src/lib/appLinks.js",
    "./lib/mimeEmail": "./src/lib/mimeEmail.js",
    "./lib/graphJson": "./src/lib/graphJson.js",
    "./lib/fleetAdmins": "./src/lib/fleetAdmins.js",
    "./persona-blocks": "./src/persona-blocks/index.js",
    "./contracts": "./contracts/index.js",
    "./testing": "./testing/index.js",
    "./knowledge": "./src/knowledge/index.js",
    "./personas/luna": "./src/personas/luna.js",
    "./personas/courtney": "./src/personas/courtney.js",
    "./personas/faceGuards": "./src/personas/faceGuards.js",
    "./lib/brand": "./src/lib/brand.js",
    "./lib/eol": "./src/lib/eol.js",
    "./lib/emailChrome": "./src/lib/emailChrome.js",
    "./lib/memoryRecall": "./src/lib/memoryRecall.js",
    "./lib/memoryRanking": "./src/lib/memoryRanking.js",
    "./lib/memoryNotes": "./src/lib/memoryNotes.js",
    "./lib/contextBudget": "./src/lib/contextBudget.js",
    "./lib/historyFold": "./src/lib/historyFold.js",
    "./lib/emailQuote": "./src/lib/emailQuote.js"
  },
  "files": [
    "src/",
    "contracts/",
    "testing/",
    "migrations/",
    "scripts/",
    "SPEC.md",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/check-dashes.mjs src/persona-blocks && node scripts/check-empty-catch.mjs --strict src && node scripts/check-graph-send-parse.mjs src && node --import ./testing/register-md.mjs --test \"test/**/*.test.js\"",
    "check:empty-catch": "node scripts/check-empty-catch.mjs src"
  },
  "engines": {
    "node": ">=20"
  }
}
